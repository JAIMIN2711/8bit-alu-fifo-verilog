module alu (
    input [7:0] A,
    input [7:0] B,
    input [2:0] opcode,
    output reg [7:0] result,
    output reg carry,
    output zero
);

always @(*) begin
    result = 8'b0;
    carry = 1'b0;

    case (opcode)
        3'b000: begin
            {carry, result} = A + B;
        end

        3'b001: begin
            result = A - B;
            carry = (A < B);
        end

        3'b010: begin
            result = A & B;
        end

        3'b011: begin
            result = A | B;
        end

        3'b100: begin
            result = A ^ B;
        end

        3'b101: begin
            result = ~A;
        end

        3'b110: begin
            result = A + 1'b1;
        end

        3'b111: begin
            result = A - 1'b1;
        end

        default: begin
            result = 8'b0;
        end
    endcase
end

assign zero = (result == 8'b0);
